[user]
	name = Aaron Agarunov
	email = agarunov.aaron@gmail.com

[commit]
	gpgsign = true

[core]
	editor = vim
	excludesFile = ~/.dotfiles/git/.gitignore

[init]
	defaultBranch = main

[alias]
	co = checkout
	cob = checkout -b

	aliases = config --get-regexp alias

	cp = cherry-pick

	l = log --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --graph --abbrev-commit

	# Interactive rebase with the given number of latest commits
	reb = "!r() { git rebase -i HEAD~$1; }; r"
	# Preserve commit date and author when rebasing
	rebp = "!r() { git -c rebase.instructionFormat='%s%nexec GIT_COMMITTER_DATE=\"%cD\" GIT_COMMITTER_NAME=\"%cn\" GIT_COMMITTER_EMAIL=\"%ce\" git commit --amend --no-edit' rebase $1; }; r"

	tags = tag -l
	branches = for-each-ref --sort=-committerdate --format='%(color:bold blue)%(authordate:relative) %(color:red)%(authorname) %(color:white)%(color:bold)%(refname:short)' refs/heads refs/remotes
	remotes = remote -v

[apply]
	whitespace = fix

[status]
	branch = true

[color "branch"]
	current = yellow reverse
	local = yellow
	remote = green

[color "diff"]
	meta = yellow bold
	frag = magenta bold
	old = red
	new = green

[color "status"]
	added = yellow
	changed = green
	untracked = cyan

[push]
	autosetupremote = true

[pull]
	autostash = true

[branch]
	autosetuprebase = always

[rebase]
	autoStash = true

[rerere]
	# record merge conflict resolutions and use them if they appear again
	# use `git rerere remaining` to see what couldn't be auto-fixed
	# NOTE: if you make a bad conflict resolution, you can `git rerere forget <file>`
	#       or `rm -rf .git/rr-cache` or `git cp --no-rerere-autoupdate`
	enabled = true
