#!/usr/bin/env bash
# chrome-host [start|url|status|gpu|stop]: GPU-backed Windows Chrome for WSL2, driven over CDP.
#   e.g. `agent-browser --cdp "$(chrome-host)" open http://localhost:3000`
# `CHROME_HOST_IDLE_MIN` shuts down the instance after N idle time (default: 10)
# `CHROME_HOST_PERSIST` keeps sign-ins between runs (default: temp profile)

set -euo pipefail

log() { printf 'chrome-host: %s\n' "$*" >&2; }
[ -n "${WSL_DISTRO_NAME:-}" ] || { log "WSL only; on macOS use local Chrome"; exit 1; }

PORT=${CHROME_HOST_PORT:-9222}
IDLE_MIN=${CHROME_HOST_IDLE_MIN:-10}
CHROME=${CHROME_HOST_EXE:-'C:\Program Files\Google\Chrome\Application\chrome.exe'}
PROFILE='$env:TEMP\chrome-debug'
[ -z "${CHROME_HOST_PERSIST:-}" ] || PROFILE='$env:LOCALAPPDATA\chrome-host'
HOST=${WSL_WINDOWS_HOST_IP:-$(ip route show default | awk '{ print $3; exit }')}
URL="http://$HOST:$PORT"

ps() { powershell.exe -NoProfile -NonInteractive -Command "$1" | tr -d '\r'; }
up() { curl -fsS -m 2 -H "Host: localhost:$PORT" "$URL/json/version" 2>/dev/null; }
clients() { ss -Htn state established "dst $HOST:$PORT"; }

stop() {
  ps "Get-CimInstance Win32_Process -Filter \"Name='chrome.exe'\" |
    Where-Object { \$_.CommandLine -match 'user-data-dir=.*(chrome-debug|chrome-host)' } |
    Invoke-CimMethod -MethodName Terminate -ErrorAction SilentlyContinue | Out-Null" || true
}

start() {
  if [ "$IDLE_MIN" -gt 0 ] && ! pgrep -f '^bash .*/chrome-host __watch$' >/dev/null; then
    setsid nohup "$0" __watch >/dev/null 2>&1 </dev/null &
  fi
  up >/dev/null && return
  log "launching Windows Chrome with CDP on :$PORT"
  ps "Start-Process '$CHROME' '--remote-debugging-port=$PORT','--remote-debugging-address=::',
    '--remote-allow-origins=*',\"--user-data-dir=$PROFILE\",'--no-first-run','--no-default-browser-check'" >/dev/null
  for _ in {1..50}; do up >/dev/null && return; sleep 0.2; done
  log "Chrome did not answer at $URL (Windows Firewall blocking WSL? port taken?)"
  exit 1
}

watch() {
  local idle=0
  sleep 30
  while up >/dev/null; do
    if [ -n "$(clients)" ]; then idle=0; else idle=$((idle + 1)); fi
    [ "$idle" -lt "$IDLE_MIN" ] || { stop; return; }
    sleep 60
  done
}

case ${1:-start} in
  start) start; echo "$URL" ;;
  url) echo "$URL" ;;
  status) up | jq -r .Browser && echo "$URL" || { log "not running at $URL"; exit 1; } ;;
  gpu)
    start
    agent-browser --cdp "$URL" eval "(()=>{const g=document.createElement('canvas').getContext('webgl2');const d=g&&g.getExtension('WEBGL_debug_renderer_info');return d?g.getParameter(d.UNMASKED_RENDERER_WEBGL):'no webgl2'})()"
    ;;
  stop) stop; log "stopped" ;;
  __watch) watch ;;
  -h | --help) sed -n '2,5p' "$0" | sed 's/^# \{0,1\}//' ;;
  *) log "unknown command: $1"; exit 2 ;;
esac
