{
  "atomKeymap.promptV3Features": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.formatOnSave": true,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.inlineSuggest.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairsHorizontal": false,
  "[python]": {
    "editor.defaultFormatter": "ms-python.black-formatter",
  },
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": true,
  "editor.fontFamily": "'JetBrains Mono', monospace, 'Apple Color Emoji'",
  "[plaintext][markdown][json]": {
    "editor.fontFamily": "'Fantasque Sans Mono', monospace, 'Apple Color Emoji'",
  },
  "markdown.preview.fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, sans-serif",
  "editor.fontLigatures": true,
  "editor.fontSize": 14,
  "prettier.singleQuote": true,
  "window.zoomLevel": 2,
  "eslint.alwaysShowStatus": true,
  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/*.pyc": true,
  },
  "workbench.colorTheme": "boya Gray",
  "workbench.editor.customLabels.patterns": {
    "**/src/**/index.**": "${dirname}/index.${extname}",
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "git.confirmSync": false,
  "editor.guides.indentation": true,
  "editor.accessibilitySupport": "off",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "remote.autoForwardPortsSource": "hybrid",
  "svelte.enable-ts-plugin": true,
  "git.openRepositoryInParentFolders": "always",
  "explorer.confirmDragAndDrop": false,
  "playwright.reuseBrowser": false,
  "git.addAICoAuthor": "off",
  "security.allowedUNCHosts": ["wsl.localhost"],
  "python.analysis.typeCheckingMode": "basic",
  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "dotenv": false,
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "chat.viewSessions.orientation": "stacked",
  "explorer.confirmPasteNative": false,
  "extensions.ignoreRecommendations": true,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
  },
}
