{
  "editor.fontFamily": "'JetBrains Mono', monospace, 'Apple Color Emoji'",
  "editor.fontSize": 14,
  "editor.fontLigatures": true,
  "window.zoomLevel": 2,
  "workbench.colorTheme": "boya Gray",
  "editor.minimap.enabled": false,
  "editor.renderWhitespace": "boundary",
  "editor.renderControlCharacters": true,
  "editor.guides.indentation": true,
  "editor.guides.bracketPairs": "active",
  "editor.guides.bracketPairsHorizontal": false,
  "editor.bracketPairColorization.enabled": true,
  "editor.inlayHints.enabled": "offUnlessPressed",
  "editor.accessibilitySupport": "off",

  "editor.formatOnSave": true,
  "editor.multiCursorModifier": "ctrlCmd",
  "editor.gotoLocation.multipleDefinitions": "goto",
  "atomKeymap.promptV3Features": true,

  "[typescript][typescriptreact][javascript][javascriptreact][json][jsonc][html][css][scss][markdown]": {
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  },
  "[python]": {
    "editor.defaultFormatter": "charliermarsh.ruff"
  },
  "[plaintext][markdown][json]": {
    "editor.fontFamily": "'Fantasque Sans Mono', monospace, 'Apple Color Emoji'"
  },
  "prettier.singleQuote": true,
  "eslint.alwaysShowStatus": true,
  "javascript.updateImportsOnFileMove.enabled": "always",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "python.analysis.typeCheckingMode": "basic",
  "markdown.preview.fontFamily": "Inter, -apple-system, BlinkMacSystemFont, 'Segoe WPC', 'Segoe UI', system-ui, sans-serif",

  "files.exclude": {
    "**/.git": true,
    "**/.svn": true,
    "**/.hg": true,
    "**/CVS": true,
    "**/.DS_Store": true,
    "**/*.pyc": true
  },
  "explorer.confirmDragAndDrop": false,
  "explorer.confirmPasteNative": false,
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.expand": false,
  "explorer.fileNesting.patterns": {
    "*.ts": "${capture}.js",
    "*.js": "${capture}.js.map, ${capture}.min.js, ${capture}.d.ts",
    "*.jsx": "${capture}.js",
    "*.tsx": "${capture}.ts",
    "tsconfig.json": "tsconfig.*.json",
    "package.json": "package-lock.json, yarn.lock, pnpm-lock.yaml, bun.lockb, bun.lock",
    "*.sqlite": "${capture}.${extname}-*",
    "*.db": "${capture}.${extname}-*",
    "*.sqlite3": "${capture}.${extname}-*",
    "*.db3": "${capture}.${extname}-*",
    "*.sdb": "${capture}.${extname}-*",
    "*.s3db": "${capture}.${extname}-*",
    ".env": ".env.*"
  },
  "workbench.editor.customLabels.patterns": {
    "**/src/**/index.**": "${dirname}/index.${extname}"
  },

  "git.confirmSync": false,
  "git.openRepositoryInParentFolders": "always",
  "git.addAICoAuthor": "off",

  "github.copilot.enable": {
    "*": false,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "dotenv": false
  },
  "github.copilot.nextEditSuggestions.enabled": false,
  "chat.viewSessions.orientation": "stacked",

  "remote.autoForwardPortsSource": "hybrid",
  "security.allowedUNCHosts": [
    "wsl.localhost"
  ],
  "extensions.ignoreRecommendations": true,
  "telemetry.telemetryLevel": "off"
}
